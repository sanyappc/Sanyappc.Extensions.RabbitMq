<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Alexander Mokrov</Authors>
    <Copyright>Copyright (c) 2026 Alexander Mokrov</Copyright>
    <Description>A .NET library for publishing and consuming RabbitMQ messages. Supports typed JSON messaging, manual acknowledgement, request/reply via Direct Reply-to, configurable reply timeout, automatic connection recovery, multiple broker connections, well-typed exceptions, health checks, and built-in OpenTelemetry tracing, metrics and structured logs following messaging semantic conventions. Ships a Roslyn analyzer that flags polymorphic message types passed or read as a derived type at compile time.</Description>
    <PackageTags>rabbitmq messaging amqp consumer producer request-reply rpc connection-recovery opentelemetry tracing metrics logging health-checks hosted-service roslyn-analyzer dotnet extensions</PackageTags>
    <PackageProjectUrl>https://github.com/sanyappc/Sanyappc.Extensions.RabbitMq</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sanyappc/Sanyappc.Extensions.RabbitMq</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" Version="10.*" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sanyappc.Extensions.RabbitMq.Analyzers\Sanyappc.Extensions.RabbitMq.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_IncludeAnalyzerInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_IncludeAnalyzerInPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="..\Sanyappc.Extensions.RabbitMq.Analyzers\bin\$(Configuration)\netstandard2.0\Sanyappc.Extensions.RabbitMq.Analyzers.dll"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
